(defun init-pageflow-workspace-multi-term ()
  (interactive)
  (let* ((base-dir (expand-file-name "~/code/pageflow-workspaces"))
         (subdirs (directory-files base-dir nil "^[^.]"))
         (default (car subdirs))
         (workspace (completing-read (format "Workspace [%s]: " default) subdirs nil t nil nil default))
         (register (read-char "Register: "))
         (buffer-name (format "*pageflow -- %s*" workspace))
         (workspace-dir (expand-file-name workspace base-dir)))
    (if (get-buffer buffer-name)
        (with-current-buffer buffer-name
          (point-to-register register))
      (let ((vterm-buffer-name buffer-name)
            (default-directory workspace-dir))
        (vterm)
        (point-to-register register)))))
